# cp configs/settings.example.env .env
#
# Everything already works with no .env at all — the default config points every
# route at the local mock gateway. These variables are how you point a route at a
# real provider (or the classroom gateway / GPU box) WITHOUT touching code.

# --- The course gateway (LiteLLM-style proxy; you never hold a raw provider key)
# MURSHID_PRIMARY_BASE_URL=https://gateway.classroom.local/v1
# MURSHID_PRIMARY_API_KEY=sk-participant-07

# MURSHID_CHEAP_BASE_URL=https://gateway.classroom.local/v1
# MURSHID_CHEAP_API_KEY=sk-participant-07

# --- Anthropic Messages dialect (comparison route)
# MURSHID_COMPARISON_BASE_URL=https://api.anthropic.com
# MURSHID_COMPARISON_API_KEY=sk-ant-...

# --- The open-weight route: vLLM on the classroom GPU server
# MURSHID_VLLM_BASE_URL=http://gpu-server.classroom.local:8000/v1
# MURSHID_VLLM_API_KEY=class-vllm-key

# --- Lab 6 switches (also settable per-command: `make replay CACHE=1`)
# MURSHID_CACHE_ENABLED=1
# MURSHID_SEMANTIC_CACHE_ENABLED=1
# MURSHID_ROUTING_ENABLED=1
